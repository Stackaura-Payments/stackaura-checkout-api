generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id                    String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                  String
  email                 String                @unique
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt
  payfastMerchantId     String?
  payfastMerchantKey    String?
  payfastPassphrase     String?
  ozowSiteCode          String?
  ozowPrivateKey        String?
  ozowApiKey            String?
  platformFeeBps        Int                   @default(0)
  platformFeeFixedCents Int                   @default(0)
  gatewayOrder          Json                  @default("[\"OZOW\", \"PAYFAST\"]")
  payfastIsSandbox      Boolean               @default(true)
  ozowIsTest            Boolean?
  yocoPublicKey         String?
  yocoSecretKey         String?
  yocoTestMode          Boolean?
  yocoWebhookId         String?
  yocoWebhookSecret     String?
  yocoWebhookUrl        String?
  paystackSecretKey     String?
  paystackTestMode      Boolean?
  planCode              String                @default("growth")
  whatsappPhoneNumberId String?               @unique
  whatsappWabaId        String?
  apiKeys               ApiKey[]
  memberships           Membership[]
  routing               MerchantRouting?
  MessageUsage          MessageUsage[]
  paymentIntents        PaymentIntent[]
  subscriptions         Subscription[]
  ledgerEntries         LedgerEntry[]
  payments              Payment[]
  payouts               Payout[]
  ShopifyInstall        ShopifyInstall[]
  supportConversations  SupportConversation[]
  supportEscalations    SupportEscalation[]
  webhooks              WebhookEndpoint[]
  jarvisExecutions      JarvisExecution[]
  jarvisApprovals       JarvisApproval[]

  @@index([whatsappWabaId])
}

model ApiKey {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId String
  keyHash    String    @unique
  label      String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  last4      String?
  prefix     String?
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model User {
  id                           String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  email                        String                 @unique
  passwordHash                 String
  isActive                     Boolean                @default(true)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @default(now()) @updatedAt
  memberships                  Membership[]
  supportConversations         SupportConversation[]
  supportEscalations           SupportEscalation[]
  jarvisExecutions             JarvisExecution[]
  jarvisApprovals              JarvisApproval[]
  jarvisOwnerApprovals         JarvisOwnerApproval[]  @relation("JarvisOwnerApprovalOwner")
  jarvisOwnerApprovalRequests  JarvisOwnerApproval[]  @relation("JarvisOwnerApprovalRequester")
  jarvisOwnerApprovalDecisions JarvisOwnerApproval[]  @relation("JarvisOwnerApprovalDecider")
  jarvisOwnerOperations        JarvisOwnerOperation[]
  jarvisApprovalDecisions      JarvisApproval[]       @relation("JarvisApprovalDecider")
}

model Membership {
  id         String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String
  merchantId String
  role       MembershipRole @default(OWNER)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
  @@index([merchantId])
  @@index([userId])
}

model JarvisExecution {
  id         String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId String
  userId     String?

  agent      String
  toolId     String
  intent     String
  permission String
  approved   Boolean               @default(false)
  status     JarvisExecutionStatus @default(STARTED)

  request Json?
  result  Json?
  error   String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  approval JarvisApproval?

  @@index([merchantId])
  @@index([userId])
  @@index([toolId])
  @@index([agent])
  @@index([status])
  @@index([createdAt])
}

model JarvisOwnerApproval {
  id                String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  ownerId           String
  requestedByUserId String
  decidedByUserId   String?
  executionId       String? @unique

  toolId    String
  intent    String
  arguments Json?
  riskLevel String               @default("MEDIUM")
  status    JarvisApprovalStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  owner       User                  @relation("JarvisOwnerApprovalOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  requestedBy User                  @relation("JarvisOwnerApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  decidedBy   User?                 @relation("JarvisOwnerApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  execution   JarvisOwnerOperation? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([requestedByUserId])
  @@index([decidedByUserId])
  @@index([status])
  @@index([toolId])
  @@index([requestedAt])
  @@index([expiresAt])
}

model JarvisOwnerOperation {
  id      String @id @default(dbgenerated("(gen_random_uuid())::text"))
  ownerId String
  userId  String

  agent      String
  toolId     String
  intent     String
  permission String
  approved   Boolean                    @default(false)
  status     JarvisOwnerOperationStatus @default(STARTED)

  request Json?
  result  Json?
  error   String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  approval JarvisOwnerApproval?

  @@index([ownerId])
  @@index([userId])
  @@index([toolId])
  @@index([agent])
  @@index([status])
  @@index([createdAt])
}

model JarvisApproval {
  id              String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId      String
  userId          String?
  decidedByUserId String?
  executionId     String? @unique

  toolId    String
  intent    String
  arguments Json?
  status    JarvisApprovalStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  merchant  Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  decidedBy User?            @relation("JarvisApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  execution JarvisExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([userId])
  @@index([decidedByUserId])
  @@index([status])
  @@index([toolId])
  @@index([requestedAt])
  @@index([expiresAt])
}

model MerchantRouting {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId      String   @unique
  enabledGateways Json     @default("[\"OZOW\", \"PAYFAST\"]")
  gatewayOrder    Json     @default("[\"OZOW\", \"PAYFAST\"]")
  failoverEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model Payment {
  id               String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId       String
  reference        String           @unique
  currency         String           @default("ZAR")
  amountCents      Int
  status           PaymentStatus    @default(CREATED)
  gateway          GatewayProvider?
  checkoutToken    String           @unique
  expiresAt        DateTime
  customerEmail    String?
  description      String?
  gatewayRef       String?
  rawGateway       Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  platformFeeCents Int              @default(0)
  merchantNetCents Int              @default(0)
  baseAmountCents  Int              @default(0)
  providerFeeCents Int?
  merchant         Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  attempts         PaymentAttempt[]

  @@index([merchantId])
  @@index([merchantId, createdAt])
  @@index([merchantId, reference])
  @@index([status])
}

model PaymentAttempt {
  id          String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  paymentId   String
  gateway     GatewayProvider
  status      String          @default("CREATED")
  redirectUrl String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt(sort: Desc)])
}

model Payout {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId      String
  reference       String          @unique
  currency        String          @default("ZAR")
  amountCents     Int
  status          PayoutStatus    @default(CREATED)
  rail            PayoutRail
  provider        PayoutProvider?
  derivAccountId  String?
  beneficiaryName String?
  providerRef     String?
  failureCode     String?
  failureMessage  String?
  rawProvider     Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  idempotencyKey  String?
  merchant        Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId])
  @@index([status])
  @@index([rail])
}

model SupportConversation {
  id            String                    @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId    String
  userId        String
  title         String?
  status        SupportConversationStatus @default(OPEN)
  lastMessageAt DateTime                  @default(now())
  escalatedAt   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @default(now()) @updatedAt
  merchant      Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  escalations   SupportEscalation[]
  messages      SupportMessage[]

  @@index([merchantId, lastMessageAt(sort: Desc)])
  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([status])
}

model SupportMessage {
  id              String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId  String
  role            SupportMessageRole
  content         String
  citations       Json?
  contextSnapshot Json?
  createdAt       DateTime            @default(now())
  conversation    SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model SupportEscalation {
  id             String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId String
  merchantId     String
  userId         String
  reason         String
  summary        String
  payload        Json
  emailTo        String                  @default("wesupport@stackaura.co.za")
  status         SupportEscalationStatus @default(PENDING)
  sentAt         DateTime?
  failureMessage String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @default(now()) @updatedAt
  conversation   SupportConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  merchant       Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([status])
}

model ShopifyInstall {
  id                        String                       @id @default(dbgenerated("(gen_random_uuid())::text"))
  shopDomain                String                       @unique
  accessToken               String
  scope                     String?
  installedAt               DateTime                     @default(now())
  updatedAt                 DateTime                     @default(now()) @updatedAt
  merchantId                String?
  Merchant                  Merchant?                    @relation(fields: [merchantId], references: [id])
  supportAgentConfig        ShopifySupportAgentConfig?
  supportAgentConversations ShopifySupportConversation[]

  @@index([shopDomain])
  @@index([merchantId])
}

model ShopifySupportAgentConfig {
  id                               String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  shopDomain                       String         @unique
  enabled                          Boolean        @default(false)
  greetingMessage                  String?
  supportEmail                     String?
  escalationEnabled                Boolean        @default(true)
  escalationLabel                  String?
  themePreference                  String         @default("auto")
  positionPreference               String         @default("bottom-right")
  createdAt                        DateTime       @default(now())
  updatedAt                        DateTime       @default(now()) @updatedAt
  storefrontWidgetActivatedAt      DateTime?
  storefrontWidgetLastSeenAt       DateTime?
  storefrontWidgetActivationSource String?
  storefrontWidgetLastPageUrl      String?
  shippingInfo                     String?
  returnsPolicy                    String?
  paymentMethodsEnabled            String?
  storeHelpSummary                 String?
  shop                             ShopifyInstall @relation(fields: [shopDomain], references: [shopDomain], onDelete: Cascade)

  @@index([shopDomain])
}

model ShopifySupportConversation {
  id                   String                              @id @default(dbgenerated("(gen_random_uuid())::text"))
  shopDomain           String
  sessionId            String
  startedAt            DateTime                            @default(now())
  lastMessageAt        DateTime                            @default(now())
  lastUserMessage      String?
  lastAssistantMessage String?
  escalationOffered    Boolean                             @default(false)
  supportEmailShown    Boolean                             @default(false)
  shop                 ShopifyInstall                      @relation(fields: [shopDomain], references: [shopDomain], onDelete: Cascade)
  messages             ShopifySupportConversationMessage[]

  @@unique([shopDomain, sessionId])
  @@index([shopDomain, lastMessageAt(sort: Desc)])
}

model ShopifySupportConversationMessage {
  id             String                     @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId String
  role           ShopifySupportMessageRole
  message        String
  pageUrl        String?
  createdAt      DateTime                   @default(now())
  metadata       Json?
  conversation   ShopifySupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model WebhookEndpoint {
  id         String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId String
  url        String
  secret     String
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @default(now()) @updatedAt
  deliveries WebhookDelivery[]
  merchant   Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model WebhookDelivery {
  id                String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  webhookEndpointId String
  event             String
  payload           Json
  status            WebhookDeliveryStatus @default(PENDING)
  attempts          Int                   @default(0)
  lastStatusCode    Int?
  lastError         String?
  nextAttemptAt     DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt
  webhookEndpoint   WebhookEndpoint       @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@index([webhookEndpointId])
  @@index([status])
  @@index([nextAttemptAt])
}

model WebhookEvent {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  provider        String
  providerEventId String
  eventType       String?
  payoutReference String?
  payload         Json
  signature       String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@unique([provider, providerEventId])
  @@index([payoutReference])
  @@index([processedAt])
}

model MessageUsage {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId  String
  channel     String
  direction   String
  messageId   String?
  waId        String?
  replySource String?
  createdAt   DateTime @default(now())
  Merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([channel])
  @@index([createdAt])
  @@index([direction])
  @@index([merchantId])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum JarvisOwnerOperationStatus {
  STARTED
  SUCCEEDED
  FAILED
  DENIED
}

enum JarvisExecutionStatus {
  STARTED
  SUCCEEDED
  FAILED
  DENIED
}

enum JarvisApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum GatewayProvider {
  PAYFAST
  OZOW
  PEACH
  YOCO
  PAYSTACK
}

enum PayoutStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
}

enum SupportConversationStatus {
  OPEN
  ESCALATED
  CLOSED
}

enum SupportMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum SupportEscalationStatus {
  PENDING
  SENT
  FAILED
}

enum ShopifySupportMessageRole {
  USER
  ASSISTANT
}

enum PayoutRail {
  DERIV
  BANK_EFT
  CARD
  CRYPTO
}

enum PayoutProvider {
  DERIV_PA
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

model PaymentIntent {
  id            String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId    String
  amountCents   Int
  currency      String       @default("ZAR")
  status        IntentStatus @default(REQUIRES_PAYMENT_METHOD)
  customerEmail String?
  description   String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  merchant Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  attempts PaymentAttemptIntent[]

  @@index([merchantId])
  @@index([status])
}

model PaymentAttemptIntent {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  paymentIntentId String
  gateway         GatewayProvider
  status          String          @default("CREATED")
  gatewayRef      String?
  rawGateway      Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([paymentIntentId])
}

model Subscription {
  id            String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId    String
  customerEmail String
  amountCents   Int
  currency      String               @default("ZAR")
  interval      SubscriptionInterval
  status        SubscriptionStatus   @default(ACTIVE)
  nextBillingAt DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now()) @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([status])
}

model LedgerEntry {
  id         String @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId String

  // Logical reference to what generated this ledger movement
  paymentIntentId String?
  paymentId       String?
  payoutId        String?

  // Double-entry accounting fields
  account   LedgerAccount
  direction LedgerDirection

  amountCents Int
  currency    String @default("ZAR")

  // Optional running balance snapshot for fast analytics
  balanceAfter Int?

  description String?
  createdAt   DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([account])
  @@index([paymentIntentId])
}

enum IntentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SubscriptionInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum LedgerAccount {
  CUSTOMER_FUNDS
  MERCHANT_BALANCE
  PLATFORM_FEES
  GATEWAY_SETTLEMENT
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model IdempotencyKey {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  merchantId      String
  scope           String
  idempotencyKey  String
  requestHash     String
  paymentId       String?
  paymentIntentId String?
  createdAt       DateTime @default(now())

  @@unique([merchantId, scope, idempotencyKey])
  @@index([merchantId])
  @@index([paymentId])
  @@index([paymentIntentId])
}
